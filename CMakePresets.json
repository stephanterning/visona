{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos-only",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "xcode",
      "displayName": "macOS: app, plugins and tests, Xcode project",
      "inherits": ["base", "macos-only"],
      "generator": "Xcode",
      "cacheVariables": {
        "VISONA_BUILD_APP": "ON",
        "VISONA_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS: app, plugins and tests, Ninja, Release",
      "inherits": ["base", "macos-only"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VISONA_BUILD_APP": "ON",
        "VISONA_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "macos-plugin",
      "displayName": "macOS: plugins and tests only, Ninja, Release",
      "inherits": ["base", "macos-only"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VISONA_BUILD_APP": "OFF",
        "VISONA_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "linux-plugin",
      "displayName": "Linux: plugins and tests only, GCC, Ninja, Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VISONA_BUILD_APP": "OFF",
        "VISONA_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "windows-plugin",
      "displayName": "Windows: plugins and tests only, MSVC, Ninja, Release (run from a Developer prompt)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VISONA_BUILD_APP": "OFF",
        "VISONA_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "core-gcc",
      "displayName": "Core and tests only (no JUCE), GCC, Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VISONA_BUILD_APP": "OFF"
      }
    },
    {
      "name": "core-clang",
      "displayName": "Core and tests only (no JUCE), Clang, Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VISONA_BUILD_APP": "OFF"
      }
    },
    {
      "name": "core-sanitize",
      "displayName": "Core and tests only (no JUCE), Clang, Debug, ASan + UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VISONA_BUILD_APP": "OFF",
        "VISONA_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "core-tsan",
      "displayName": "Core and tests only (no JUCE), Clang, Debug, TSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VISONA_BUILD_APP": "OFF",
        "VISONA_SANITIZERS": "thread"
      }
    },
    {
      "name": "pi",
      "displayName": "Linux ARM64 app and tests (Raspberry Pi OS), GCC, Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VISONA_BUILD_APP": "ON"
      },
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "1"
      }
    },
    {
      "name": "pi-ci",
      "displayName": "Linux ARM64 app and tests, parallel build (CI Pi build), GCC, Release",
      "inherits": "pi",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": null
      }
    },
    {
      "name": "pi-quick",
      "displayName": "Linux ARM64 app only, no tests, parallel build (CI quick Pi build), GCC, Release",
      "inherits": "pi-ci",
      "cacheVariables": {
        "VISONA_BUILD_TESTS": "OFF",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    }
  ],
  "buildPresets": [
    { "name": "xcode", "configurePreset": "xcode", "configuration": "Debug" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "macos-plugin", "configurePreset": "macos-plugin" },
    { "name": "linux-plugin", "configurePreset": "linux-plugin" },
    { "name": "windows-plugin", "configurePreset": "windows-plugin" },
    { "name": "core-gcc", "configurePreset": "core-gcc" },
    { "name": "core-clang", "configurePreset": "core-clang" },
    { "name": "core-sanitize", "configurePreset": "core-sanitize" },
    { "name": "core-tsan", "configurePreset": "core-tsan" },
    { "name": "pi", "configurePreset": "pi", "jobs": 1 },
    { "name": "pi-ci", "configurePreset": "pi-ci" },
    { "name": "pi-quick", "configurePreset": "pi-quick", "targets": ["Visona"] }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "xcode", "inherits": "base", "configurePreset": "xcode", "configuration": "Debug" },
    { "name": "macos", "inherits": "base", "configurePreset": "macos" },
    { "name": "macos-plugin", "inherits": "base", "configurePreset": "macos-plugin" },
    { "name": "linux-plugin", "inherits": "base", "configurePreset": "linux-plugin" },
    { "name": "windows-plugin", "inherits": "base", "configurePreset": "windows-plugin" },
    { "name": "core-gcc", "inherits": "base", "configurePreset": "core-gcc" },
    { "name": "core-clang", "inherits": "base", "configurePreset": "core-clang" },
    {
      "name": "core-sanitize",
      "inherits": "base",
      "configurePreset": "core-sanitize",
      "environment": {
        "ASAN_OPTIONS": "strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "core-tsan",
      "inherits": "base",
      "configurePreset": "core-tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    { "name": "pi", "inherits": "base", "configurePreset": "pi" },
    { "name": "pi-ci", "inherits": "base", "configurePreset": "pi-ci" }
  ]
}
